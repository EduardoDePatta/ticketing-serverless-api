{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node", "aws-lambda", "jest"],
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*.ts", "serverless.ts", "infra/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".serverless", "dist"]
}
