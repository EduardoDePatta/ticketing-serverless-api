{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": [
            "node",
            "aws-lambda"
        ],
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "serverless.ts"
    ],
    "exclude": [
        "node_modules",
        ".serverless",
        "dist"
    ]
}
