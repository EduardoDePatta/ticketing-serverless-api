{
  "name": "ticketing-serverless-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "bootstrap:deploy": "serverless deploy --config infra/ci-bootstrap/serverless.ts --stage shared",
    "bootstrap:remove": "serverless remove --config infra/ci-bootstrap/serverless.ts --stage shared",
    "remove:dev": "serverless remove --stage dev",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "eslint . --max-warnings 0 && prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md,yml,yaml}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduardoDePatta/ticketing-serverless-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/EduardoDePatta/ticketing-serverless-api/issues"
  },
  "homepage": "https://github.com/EduardoDePatta/ticketing-serverless-api#readme",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1044.0",
    "@aws-sdk/client-secrets-manager": "^3.1044.0",
    "@aws-sdk/lib-dynamodb": "^3.1044.0",
    "hash-wasm": "^4.12.0",
    "jsonwebtoken": "^9.0.3",
    "stripe": "^22.1.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@serverless/typescript": "^4.30.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^17.0.2",
    "prettier": "^3.5.3",
    "serverless": "^4.35.1",
    "ts-jest": "^29.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
